!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>SHIRTX PANEL</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#0b0b0b;
overflow:hidden;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
}

canvas{
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
z-index:-1;
}

.panel{
width:380px;
max-width:95%;
}

.profile{
text-align:center;
margin-bottom:25px;
}

.profile img{
width:95px;
height:95px;
border-radius:50%;
border:3px solid #888;
object-fit:cover;
}

.profile h1{
margin-top:10px;
font-size:42px;
letter-spacing:3px;
}

.card{
background:#181818;
border:1px solid #2c2c2c;
border-radius:18px;
padding:18px;
margin-bottom:15px;
display:flex;
justify-content:space-between;
align-items:center;
}

.left{
display:flex;
align-items:center;
gap:15px;
}

.icon{
width:52px;
height:52px;
border-radius:12px;
background:#101010;
display:flex;
justify-content:center;
align-items:center;
font-size:24px;
}

.title{
font-size:20px;
font-weight:600;
}

.desc{
font-size:13px;
color:#aaa;
}

.switch{
position:relative;
display:inline-block;
width:55px;
height:30px;
}

.switch input{
display:none;
}

.slider{
position:absolute;
cursor:pointer;
top:0;
left:0;
right:0;
bottom:0;
background:#555;
transition:.3s;
border-radius:30px;
}

.slider:before{
content:"";
position:absolute;
width:24px;
height:24px;
left:3px;
bottom:3px;
background:white;
border-radius:50%;
transition:.3s;
}

input:checked+.slider{
background:#3cff7b;
}

input:checked+.slider:before{
transform:translateX(25px);
}

.buttons{
display:flex;
gap:12px;
margin-top:20px;
}

button{
flex:1;
height:55px;
border:none;
border-radius:16px;
background:#2d2d2d;
color:#fff;
font-size:20px;
cursor:pointer;
transition:.25s;
}

button:hover{
background:#444;
}
</style>
</head>

<body>

<canvas id="bg"></canvas>

<div class="panel">

<div class="profile">
<img src="https://i.imgur.com/4Z7Dz8Q.png">
<h1>SHIRTX</h1>
</div>

<div class="card">
<div class="left">
<div class="icon">🎯</div>
<div>
<div class="title">Configuração 1</div>
<div class="desc">UI Demo</div>
</div>
</div>

<label class="switch">
<input type="checkbox">
<span class="slider"></span>
</label>
</div>

<div class="card">
<div class="left">
<div class="icon">⚡</div>
<div>
<div class="title">Configuração 2</div>
<div class="desc">UI Demo</div>
</div>
</div>

<label class="switch">
<input type="checkbox">
<span class="slider"></span>
</label>
</div>

<div class="card">
<div class="left">
<div class="icon">👆</div>
<div>
<div class="title">Configuração 3</div>
<div class="desc">UI Demo</div>
</div>
</div>

<label class="switch">
<input type="checkbox">
<span class="slider"></span>
</label>
</div>

<div class="card">
<div class="left">
<div class="icon">🎮</div>
<div>
<div class="title">Configuração 4</div>
<div class="desc">UI Demo</div>
</div>
</div>

<label class="switch">
<input type="checkbox">
<span class="slider"></span>
</label>
</div>

<div class="buttons">
<button>⚡ START TH</button>
<button>⚡ START MAX</button>
</div>

</div>

<script>
const canvas=document.getElementById("bg");
const ctx=canvas.getContext("2d");

function resize(){
canvas.width=window.innerWidth;
canvas.height=window.innerHeight;
}
resize();
window.onresize=resize;

let stars=[];

for(let i=0;i<80;i++){
stars.push({
x:Math.random()*canvas.width,
y:Math.random()*canvas.height,
vx:(Math.random()-0.5)*0.3,
vy:(Math.random()-0.5)*0.3
});
}

function draw(){

ctx.clearRect(0,0,canvas.width,canvas.height);

for(let s of stars){

s.x+=s.vx;
s.y+=s.vy;

if(s.x<0||s.x>canvas.width)s.vx*=-1;
if(s.y<0||s.y>canvas.height)s.vy*=-1;

ctx.fillStyle="white";
ctx.beginPath();
ctx.arc(s.x,s.y,2,0,Math.PI*2);
ctx.fill();

for(let t of stars){

let dx=s.x-t.x;
let dy=s.y-t.y;
let dist=Math.sqrt(dx*dx+dy*dy);

if(dist<120){
ctx.strokeStyle="rgba(255,255,255,"+(1-dist/120)*0.15+")";
ctx.beginPath();
ctx.moveTo(s.x,s.y);
ctx.lineTo(t.x,t.y);
ctx.stroke();
}

}

}

requestAnimationFrame(draw);

}

draw();
</script>

</body>
</html>
